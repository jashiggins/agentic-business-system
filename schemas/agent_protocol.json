    },
    "routing": {
      "type": "object",
      "description": "Routing rules and broker behavior.",
      "properties": {
        "use_message_broker": {
          "type": "boolean",
          "default": true
        },
        "broker_requirements": {
          "type": "object",
          "properties": {
            "durable_persistence": {
              "type": "boolean",
              "default": true
            },
            "ordered_delivery": {
              "type": "boolean",
              "default": true
            },
            "at_least_once": {
              "type": "boolean",
              "default": true
            },
            "dead_letter_queue": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "routing_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "match",
              "route_to"
            ],
            "properties": {
              "match": {
                "type": "object",
                "description": "Match conditions for envelope fields"
              },
              "route_to": {
                "type": "string",
                "description": "Agent id or broker topic/queue"
              },
              "priority_override": {
                "type": "string",
                "enum": [
                  "LOW",
                  "NORMAL",
                  "HIGH",
                  "CRITICAL"
                ]
              }
            }
          }
        },
        "dlq_policy": {
          "type": "object",
          "properties": {
            "max_delivery_attempts": {
              "type": "number",
              "default": 5
            },
            "backoff_strategy": {
              "type": "string",
              "enum": [
                "exponential",
                "linear"
              ],
              "default": "exponential"
            },
            "notify_on_dlq": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "description": "Security and compliance rules for messages.",
      "required": [
        "encryption",
        "signing",
        "access_control"
      ],
      "properties": {
        "encryption": {
          "type": "object",
          "properties": {
            "in_transit": {
              "type": "string",
              "enum": [
                "TLS1.2",
                "TLS1.3"
              ],
              "default": "TLS1.3"
            },
            "at_rest": {
              "type": "string",
              "enum": [
                "AES-256",
                "KMS-managed"
              ],
              "default": "KMS-managed"
            }
          }
        },
        "signing": {
          "type": "object",
          "properties": {
            "required_for": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "List of intents that require cryptographic signing. If an intent is listed here, envelope.signature must be present."
            },
            "signature_algorithm": {
              "type": "string",
              "default": "RSASSA-PSS-SHA256"
            }
          }
        },
        "access_control": {
          "type": "object",
          "properties": {
            "rbac_required": {
              "type": "boolean",
              "default": true
            },
            "audit_access": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "dlp": {
          "type": "object",
          "properties": {
            "sensitive_patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "actions_on_detection": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "quarantine",
                  "redact",
                  "block",
                  "notify"
                ]
              }
            }
          }
        }
      }
    },
    "response_schema": {
      "type": "object",
      "description": "Standardized response envelope for agent replies.",
      "required": [
        "message_id",
        "in_reply_to",
        "timestamp",
        "status",
        "result"
      ],
      "properties": {
        "message_id": {
          "type": "string"
        },
        "in_reply_to": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "OK",
            "ERROR",
            "PENDING",
            "DEFERRED",
            "ESCALATED"
          ]
        },
        "result": {
          "type": "object"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object"
            }
          }
        }
      }
    },
    "examples": {
      "type": "object",
      "description": "Concrete message examples for common flows.",
      "properties": {
        "lead_capture": {
          "type": "object",
          "example": {
            "message_id": "msg-0001",
            "timestamp": "2026-04-25T16:00:00Z",
            "from_agent_id": "agent_unified_comms",
            "to_agent_id": "agent_marketing",
            "intent": "CREATE_LEAD",
            "payload": {
              "lead": {
                "email": "lead@example.com",
                "name": "Test Lead",
                "source": "website_form"
              }
            },
            "metadata": {
              "correlation_id": "thread-123",
              "priority": "NORMAL",
              "requires_security_review": false,
              "sensitivity": "CONFIDENTIAL",
              "persist": true
            }
          }
        },
        "security_alert": {
          "type": "object",
          "example": {
            "message_id": "msg-9001",
            "timestamp": "2026-04-25T16:10:00Z",
            "from_agent_id": "agent_security",
            "to_agent_id": "agent_ceo",
            "intent": "SECURITY_EVENT",
            "payload": {
              "event_id": "sec-0001",
              "category": "PHISHING_SUSPECTED",
              "severity": "HIGH",
              "summary": "Quarantined phishing email targeting users",
              "artifacts": {
                "url": "http://malicious.example/login",
                "sender": "attacker@example.com"
              }
            },
            "metadata": {
              "correlation_id": "sec-thread-1",
              "priority": "HIGH",
              "requires_security_review": true,
              "sensitivity": "RESTRICTED",
              "persist": true,
              "immutable_log_ref": "ledger-0001"
            },
            "signature": "kms-sig:BASE64_PLACEHOLDER"
          }
        }
      }
    },
    "versioning_and_compatibility": {
      "type": "object",
      "properties": {
        "backward_compatibility": {
          "type": "string",
          "description": "Policy for backward compatibility",
          "default": "Minor versions add fields and intents without breaking existing consumers. Major versions may remove or rename fields and intents."
        },
        "deprecation_policy": {
          "type": "string",
          "description": "How intents or fields are deprecated",
          "default": "Intents marked status=deprecated remain in the catalog for at least one minor version after deprecation announcement. Removed intents are documented in CHANGELOG.md."
        }
      }
    }
  }
}