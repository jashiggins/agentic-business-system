{
  "name": "Data Leak Detection and Recovery",
  "description": "Simulate a bulk export attempt; Privacy and Security Agents detect and block export, suspend credentials, and initiate recovery.",
  "steps": [
    {
      "message_id": "m1",
      "intent": "EXPORT_REQUEST",
      "from_agent_id": "agent_research",
      "to_agent_id": "data_store_service",
      "payload": {
        "request_id": "export-2026-01",
        "requested_by": "agent_research",
        "data_source": "customers",
        "query_description": "All customers created before 2026-01-01 for cohort retention analysis",
        "filters": {"created_before": "2026-01-01"},
        "estimated_rows": 120000,
        "sensitivity": "RESTRICTED",
        "fields": ["customer_id", "email", "name", "created_at", "plan_tier"],
        "purpose": "Cohort retention analysis for product strategy",
        "lawful_basis": "legitimate_interest",
        "destination": "s3://internal-analytics/cohort-2026/",
        "retention_days": 90
      }
    },
    {
      "message_id": "m2",
      "intent": "DETECT_BULK_EXPORT",
      "from_agent_id": "data_store_service",
      "to_agent_id": "agent_privacy",
      "payload": {
        "request_id": "export-2026-01",
        "rows": 120000,
        "sensitivity": "HIGH",
        "timestamp": "2026-04-25T16:30:00Z"
      }
    },
    {
      "message_id": "m3",
      "intent": "BLOCK_EXPORT",
      "from_agent_id": "agent_privacy",
      "to_agent_id": "data_store_service",
      "payload": {
        "request_id": "export-2026-01",
        "action": "deny",
        "reason": "Sensitivity RESTRICTED and row count 120000 exceeds threshold without approved business case."
      }
    },
    {
      "message_id": "m4",
      "intent": "REVOKE_CREDENTIALS",
      "from_agent_id": "agent_privacy",
      "to_agent_id": "agent_security",
      "payload": {
        "request_id": "rev-2026-04-26-001",
        "affected_principal": "agent_research",
        "principal_type": "agent",
        "action": "suspend",
        "duration_minutes": null,
        "reason": "Unapproved bulk export attempt of 120,000 customer records; investigation pending.",
        "requested_by": "agent_privacy",
        "linked_event_id": "sec-2026-04-25-0042"
      }
    },
    {
      "message_id": "m5",
      "intent": "INITIATE_RECOVERY",
      "from_agent_id": "agent_security",
      "to_agent_id": "agent_ceo",
      "payload": {
        "event_id": "sec-2026-04-25-0042",
        "category": "DATA_LEAK_RISK",
        "severity": "CRITICAL",
        "summary": "Blocked unapproved bulk export of 120k customer records; credentials suspended.",
        "detected_at": "2026-04-25T16:31:00Z",
        "detected_by": "agent_privacy",
        "playbook_ref": "/bootstrap/incident_response_playbooks/data_leak_playbook.txt"
      }
    }
  ],
  "assertions": [
    "Export request is blocked and not executed",
    "Affected principal credentials are suspended",
    "Security and Privacy create immutable audit entries",
    "CEO receives CRITICAL severity notification and recovery begins"
  ]
}
